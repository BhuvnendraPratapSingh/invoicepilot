# InvoicePilot Configuration
# Copy to .env and adjust as needed

# Application
APP_ENV=demo
APP_HOST=127.0.0.1
APP_PORT=8000
DEMO_MODE=true
DEMO_BUSINESS_DATE=2026-03-15

# Database
DATABASE_URL=sqlite:///./data/invoicepilot.db

# Storage
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=10
MAX_PAGES=20

# Workers
WORKER_COUNT=2

# ─── OCR Configuration ───
# Cloud OCR uses YOUR API keys - billing goes to your account
# Configure one or more providers for scanned PDF support
# Priority: OpenAI > Anthropic > Google > Tesseract (local)

# OpenAI GPT-4 Vision (get key at: https://platform.openai.com/api-keys)
# OCR_OPENAI_API_KEY=sk-...

# Anthropic Claude Vision (get key at: https://console.anthropic.com/settings/keys)
# OCR_ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini Vision (get key at: https://aistudio.google.com/app/apikey)
# OCR_GOOGLE_API_KEY=...

# OCR provider preference: auto, openai, anthropic, google, tesseract
# "auto" tries cloud providers first, then falls back to local Tesseract
OCR_PROVIDER=auto

# Optional: AI-assisted extraction (not required for local mode)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AI_EXTRACTION_ENABLED=false


# ─── Cloud OCR Configuration ───
# Cloud OCR uses YOUR API keys - billing goes to your account, not ours
# Configure one or more providers for scanned PDF support
# Priority: OpenAI > Anthropic > Google > Tesseract (local)

# OpenAI GPT-4 Vision (get key at: https://platform.openai.com/api-keys)
# OCR_OPENAI_API_KEY=sk-...

# Anthropic Claude Vision (get key at: https://console.anthropic.com/settings/keys)
# OCR_ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini Vision (get key at: https://aistudio.google.com/app/apikey)
# OCR_GOOGLE_API_KEY=...

# OCR provider preference: auto, openai, anthropic, google, tesseract
# "auto" tries cloud providers first, then falls back to local Tesseract
OCR_PROVIDER=auto
